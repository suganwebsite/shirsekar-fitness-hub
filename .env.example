# ==============================================================================
# SHIRSEKARS' FITNESS HUB - ENVIRONMENT CONFIGURATION
# Production-ready template for Vercel deployment, PostgreSQL, and Vercel Blob
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL: Neon / Supabase / Vercel Postgres) ---
# Pooled connection string used by Prisma Client in serverless runtime
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct unpooled connection string used for Prisma migrations and schema push
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- MEDIA STORAGE (Vercel Blob) ---
# Automatically injected by Vercel when connecting a Blob store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx"

# --- AUTHENTICATION & SECURITY ---
# 32+ character random secret string used to sign admin JWT session tokens
ADMIN_JWT_SECRET="shirsekar_hub_bandra_super_secure_jwt_token_secret_2026_vercel"

# Initial Super Admin credentials for the SaaS Gym Management Dashboard
ADMIN_DEFAULT_EMAIL="admin@shirsekarfitness.com"
ADMIN_DEFAULT_PASSWORD="admin123"

# --- DOMAIN & CANONICAL URLS ---
# Public URL of the deployed application (used for OG tags, sitemaps, WhatsApp redirects)
NEXT_PUBLIC_APP_URL="https://shirsekar-fitness-hub.vercel.app"

# AI Studio runtime variables (automatically injected in Google AI Studio environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://shirsekar-fitness-hub.vercel.app"
